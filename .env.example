# Sao chép file này thành .env.local rồi điền giá trị thật.
# Trên Vercel: thêm từng biến ở Project → Settings → Environment Variables.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Supabase → Project Settings → API Keys → service_role (secret)
# KHÔNG đặt tiền tố NEXT_PUBLIC_ cho biến này. Nó có toàn quyền với database.
SUPABASE_SERVICE_ROLE_KEY="..."

# Mật khẩu chung cho trang /admin của ban tổ chức.
ADMIN_PASSWORD="doi-mat-khau-nay"

# Chuỗi ngẫu nhiên tối thiểu 16 ký tự, dùng để ký cookie.
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET="..."
